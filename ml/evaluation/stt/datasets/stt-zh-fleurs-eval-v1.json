      "sha256": "0d74e3e0d9b49f3e8cd3c9bed1131a204b79321c6e3460933cd561dfcbf8775d",
      "notes": "FLEURS cmn_hans_cn/test; gender=1"
    },
    {
      "id": "fleurs-cmn_hans_cn-test-001981",
      "language": "zh",
      "reference_text": "如果只是在乘船游览的情况下登岸，则不需要单独的签证（规定截至 2009 年）。",
