# LOCAL PRODUCTION-SHAPED stack (M25) — example values only.
#
# In practice the local stack reuses your existing dev `.env` (the
# preflight checks it); this file documents every knob the local
# production-shaped profile reads, with THROWAWAY examples. Never put
# real production secrets here or in any committed file. The production
# template is `.env.prod.example` and is unchanged by M25.

# ── Edge ────────────────────────────────────────────────────────────────
# localhost => Caddy self-signs; the Cloudflare quick tunnel provides the
# real public certificate OUTSIDE this stack. The tunnel URL is printed
# by cloudflared at runtime and is NEVER configured here — see
# docs/ops/local-tunnel.md.
DOMAIN=localhost

# ── Environment (MUST NOT be prod for this profile) ─────────────────────
# The local-prod overlay serves the PENDING E3 proposal via the staging
# registry profile, which the application refuses under prod — that
# refusal is the production separation. The overlay sets
# INTELLIAI_REGISTRY_PROFILE=staging itself; do not set it here.
INTELLIAI_ENV=dev

# ── Auth / data plane (generate disposable local values) ────────────────
# openssl rand -hex 24  (or any generated >=16-char value)
INTELLIAI_AUTH_KEY_PEPPER=generate-a-disposable-local-value
POSTGRES_USER=intelliai
POSTGRES_PASSWORD=generate-a-disposable-local-value
POSTGRES_DB=intelliai
MINIO_ROOT_USER=intelliai
MINIO_ROOT_PASSWORD=generate-a-disposable-local-value

# ── Routing / limits (defaults shown; the code owns these values) ───────
# hi -> qwen3-asr-0.6b-hi-ft-e3 comes from the staging registry profile
# (the overlay), NOT from an env var. Long-audio limits are code
# defaults: 600 s ceiling, 120 s direct / 120-600 s chunked (M19);
# gateway timeout 450 s and admission lease 540 s are configuration in
# apps/api settings and need no override here.
