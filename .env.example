# ── IntelliAI local development environment ─────────────────────────────
# Copy to .env (which is gitignored — NEVER commit it):
#     cp .env.example .env
# Values below are DEV-ONLY defaults so a fresh clone works immediately.
# Production uses .env.prod.example as its template (copied to .env on
# the VPS, every value replaced — see docs/ops/deployment.md); nothing
# from THIS file may ever reach a production host. Keep both files in
# sync with every variable the platform reads — they double as
# configuration documentation.

# ── Application (consumed by apps/api) ──────────────────────────────────
INTELLIAI_ENV=dev                 # dev | test | prod
INTELLIAI_LOG_LEVEL=INFO

# Connection URLs the API uses to reach the services below.
# Host/port/credentials MUST match the infrastructure section further down.
INTELLIAI_DATABASE_URL=postgresql+asyncpg://intelliai:intelliai-dev-only@127.0.0.1:5432/intelliai
INTELLIAI_REDIS_URL=redis://127.0.0.1:6379/0
INTELLIAI_STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
INTELLIAI_STORAGE_ACCESS_KEY=intelliai
INTELLIAI_STORAGE_SECRET_KEY=intelliai-dev-only

# ── Auth ────────────────────────────────────────────────────────────────
# Server-side pepper mixed into API-key hashes. Generate a long random one:
#   openssl rand -hex 32
# WARNING: changing it invalidates every issued API key.
INTELLIAI_AUTH_KEY_PEPPER=dev-only-pepper-not-for-production

# ── PostgreSQL — system of record ───────────────────────────────────────
POSTGRES_USER=intelliai
POSTGRES_PASSWORD=intelliai-dev-only    # generate your own: openssl rand -hex 16
POSTGRES_DB=intelliai
POSTGRES_PORT=5432                       # host port; change if 5432 is taken

# ── Redis — cache & rate limiting ───────────────────────────────────────
REDIS_PORT=6379

# ── MinIO — S3-compatible object storage (dev only) ─────────────────────
MINIO_ROOT_USER=intelliai
MINIO_ROOT_PASSWORD=intelliai-dev-only   # minimum 8 characters
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
