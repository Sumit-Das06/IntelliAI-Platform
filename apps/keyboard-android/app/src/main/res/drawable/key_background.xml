<?xml version="1.0" encoding="utf-8"?>
<!-- Letter keys: ripple over a rounded card, pressed state tinted. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/kb_key_pressed">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/kb_key_pressed" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/kb_key" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
