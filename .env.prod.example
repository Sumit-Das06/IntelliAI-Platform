# ── IntelliAI PRODUCTION environment ────────────────────────────────────
# On the VPS: copy to .env next to docker-compose.yml and fill EVERY value.
#     cp .env.prod.example .env
# Never commit the filled file. Every secret below is load-bearing.

# ── Edge ────────────────────────────────────────────────────────────────
# The public hostname. DNS A record must point at this VPS BEFORE first
# start, so Caddy can obtain its Let's Encrypt certificate.
DOMAIN=api.yourdomain.com

# ── Application ─────────────────────────────────────────────────────────
INTELLIAI_ENV=prod
INTELLIAI_LOG_LEVEL=INFO

# API-key pepper. Generate once, store in your password manager, NEVER
# rotate casually (rotation invalidates every issued key):
#   openssl rand -hex 32
INTELLIAI_AUTH_KEY_PEPPER=

# Data-collection kill switch (true/false). Consent still gates per-tenant.
INTELLIAI_COLLECTION_ENABLED=true

# NEVER set INTELLIAI_REGISTRY_PROFILE here. The staging profile activates
# unreviewed model routes; the application refuses it under prod and the
# preflight fails before the application gets the chance.

# ── Model serving (defaults live in code — listed for the record) ───────
# The prod overlay pins INTELLIAI_STT_SLOTS=whisper explicitly; promoting
# a new engine is a reviewed code+compose change (docs/ops/model-rollout.md),
# never an .env edit.
#
# Long-audio shape (Milestone 19, measured and proven — do not override
# without re-running the proof battery):
#   direct pass            <= 120 s   (INTELLIAI_STT_QWEN3_DIRECT_AUDIO_SECONDS)
#   chunked inside engine  120-600 s  (window 100 s, overlap 5 s, snap 8 s)
#   request ceiling        600 s      (INTELLIAI_STT_QWEN3_MAX_AUDIO_SECONDS)
#   gateway deadline       450 s      (INTELLIAI_RUNTIMES_TIMEOUT_SECONDS)
#   admission lease        540 s      (INTELLIAI_LIMITS_LEASE_SECONDS — must
#                                      stay ABOVE the gateway deadline)

# ── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_USER=intelliai
POSTGRES_DB=intelliai
# openssl rand -hex 16
POSTGRES_PASSWORD=

# ── MinIO (S3 store for consented audio) ────────────────────────────────
MINIO_ROOT_USER=intelliai
# openssl rand -hex 16
MINIO_ROOT_PASSWORD=

# ── Backups (docs/ops/backup.md) ────────────────────────────────────────
# Off-box destination for the OBJECT-LEVEL backup (infra/backup-objects.sh).
# Any S3-compatible store: provider endpoint + a write-only key pair +
# a bucket that exists. LEAVE EMPTY and the script snapshots locally with
# a loud warning — a same-disk snapshot is NOT a production backup.
# Remote retention is the provider's lifecycle rule (recommended: expire
# objects-* prefixes after 14 days), never a delete from our side.
INTELLIAI_BACKUP_S3_URL=
INTELLIAI_BACKUP_S3_ACCESS_KEY=
INTELLIAI_BACKUP_S3_SECRET_KEY=
INTELLIAI_BACKUP_S3_BUCKET=
# Local snapshot retention (count) for pg dumps, volume tars, and object
# snapshots when no remote is configured.
INTELLIAI_OBJECT_BACKUP_KEEP=14
