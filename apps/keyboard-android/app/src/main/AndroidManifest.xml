<?xml version="1.0" encoding="utf-8"?>
<!-- Exactly two permissions, each earned by 13B's one feature:
     microphone access for user-initiated dictation, internet access for
     the IntelliAI STT request that dictation makes. Nothing else — no
     storage, no contacts, no telephony — and ScopeGuardsTest pins the
     set exactly. Audio is captured only while the user has explicitly
     started dictation, lives only in memory, and is sent only to the
     configured IntelliAI API. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.IntelliAI">

        <!-- Setup and onboarding — NOT the keyboard itself. -->
        <activity
            android:name=".setup.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The microphone-permission trampoline. An InputMethodService
             cannot host the runtime permission dialog itself, so the
             keyboard launches this invisible activity, which asks and
             reports back. Never in recents, never in history. -->
        <activity
            android:name=".dictation.PermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/Theme.IntelliAI.Invisible" />

        <!-- The correction editor. Also an activity, and for the same
             reason as the trampoline above: an InputMethodService cannot
             host its own EDITABLE dialog — a dialog on the IME window
             cannot summon a keyboard for its own text field, and dies
             when the input view is torn down. An activity owns its
             window and any IME can serve it. Not in recents; single
             instance so a second Edit tap reuses the open editor. -->
        <activity
            android:name=".dictation.CorrectionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <!-- The real input method. BIND_INPUT_METHOD is what makes this
             a system keyboard rather than an app pretending to be one:
             only the system may bind, and Android lists the service
             under Settings → Languages & input → On-screen keyboard. -->
        <service
            android:name=".service.IntelliAIKeyboardService"
            android:exported="true"
            android:label="@string/keyboard_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>

</manifest>
