<?xml version="1.0" encoding="utf-8"?>
<!-- Shift / backspace / layer / globe / enter: a quieter tone so the
     letters read as the primary surface. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/kb_key_special_pressed">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/kb_key_special_pressed" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/kb_key_special" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
