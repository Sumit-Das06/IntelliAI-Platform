# ── Environment / secrets ─────────────────────────────────────
.env
.env.*
!.env.example
!.env.prod.example

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Node (developer console) ──────────────────────────────────
node_modules/
.next/

# ── ML artifacts — weights and datasets never enter git ──────
data/
weights/
/models/
*.ckpt
*.safetensors
*.onnx
*.gguf
# Ingestion intermediates: regenerated deterministically by
# `intelliai-datasets ingest-*` from pinned sources; the committed truth
# is the frozen manifests + provenance sidecars beside them.
ml/datasets/manifests/candidates-*.json
# Large frozen TRAIN manifests are data artifacts: the committed truth is
# the provenance sidecar carrying the SHA-256 pin + the deterministic
# recipe (freeze runs are byte-identical, proven). Text ballast >1 MB
# stays out of git like audio does. (Smaller, already-tracked manifests
# remain tracked - gitignore never untracks.)
ml/datasets/manifests/hi-public-train-*.jsonl
.ipynb_checkpoints/

# ── Recorded audio — publication is irreversible ──────────────
# A corpus we built and never published is the only structurally clean
# position we hold against training-data contamination: once audio is
# committed it is crawled, it enters somebody's next training set, and
# no later decision can withdraw it. So audio is ignored by extension
# rather than by directory — the protection must not depend on the
# recording landing in the folder somebody remembered to name.
#
# `corpus-inbox/` is the recording staging area (ml/evaluation/README.md).
# It is listed separately so the directory stays ignored whatever it ends
# up holding: transcripts, rosters, consent forms, session notes.
#
# To commit audio deliberately, add a `!` exception BELOW this block with
# a comment saying why, and check that its extension is declared binary
# in .gitattributes — `text=auto eol=lf` corrupts an undeclared format.
corpus-inbox/
*.wav
*.flac
*.mp3
*.m4a
*.ogg

# Backups hold the FULL database and consented audio — they leave the
# box via rclone/rsync (docs/ops/backup.md), never via git.
backups/

# ── Android (apps/keyboard-android) ──────────────────────────
# build/ and .idea/ are already ignored above; these are the
# Android-specific artifacts. Keystores are ignored defensively —
# release signing, when it arrives, must never enter git.
.gradle/
local.properties
*.apk
*.aab
*.jks
*.keystore
keystore.properties

# ── IDE / OS ──────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────
*.log

# The metering sink of last resort: rejected ledger writes land here for a
# human to replay. It holds real customer usage — it must never be
# committed, and it must never be deleted without being reconciled first.
usage-fallback.jsonl
