<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Cleartext is scoped to the three unambiguous
     DEVELOPMENT hosts — never a blanket allowance, and never a LAN
     range (a real IP would let a debug build talk to anything on the
     network):

       10.0.2.2   the Android emulator's route to the host machine
       localhost  a PHYSICAL device reaching the host over USB, via
       127.0.0.1  `adb reverse tcp:8000 tcp:8000` — the phone connects
                  to its OWN loopback, which adb tunnels to the laptop.
                  This keeps the API's safe 127.0.0.1-only binding
                  intact: nothing is exposed to Wi-Fi.

     Release builds never merge this file — they keep the platform
     default of HTTPS-only, and ServerAddress additionally refuses
     these three hostnames outright (see ServerAddressTest). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
