# IntelliAI edge: TLS termination + reverse proxy to the gateway.
# DOMAIN comes from the environment (compose passes it through).
#   real domain  -> automatic Let's Encrypt certificates
#   localhost    -> Caddy's internal CA (self-signed; used by the
#                   from-scratch verification)
# HTTP→HTTPS redirect and certificates are automatic: with a real DOMAIN
# and DNS pointing here, Caddy obtains/renews Let's Encrypt on its own
# and answers port 80 only with redirects (auto_https).
{$DOMAIN:localhost} {
	encode gzip

	# First line of the body-size defense (the gateway enforces the same
	# ceiling at read time, the STT runtime validates the audio itself):
	# an oversized upload is refused at the edge before it costs Python
	# a byte of memory. Matches INTELLIAI_LIMITS_MAX_REQUEST_BYTES.
	request_body {
		max_size 30MB
	}

	header {
		# One year of HTTPS-only for browsers that have seen us once.
		Strict-Transport-Security "max-age=31536000"
		# The console serves user-influenced text (transcripts); never
		# let a browser second-guess declared content types.
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# No server fingerprint in responses.
		-Server
	}

	# The gateway sets X-Request-ID itself; Caddy only forwards.
	reverse_proxy api:8000
}
